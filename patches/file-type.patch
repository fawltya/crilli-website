diff --git a/index.mjs b/index.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d4f0804828bf33d8f05add0358919824b95a36e1
--- /dev/null
+++ b/index.mjs
@@ -0,0 +1,20 @@
+// ESM wrapper for file-type CommonJS module
+import { createRequire } from 'module';
+const require = createRequire(import.meta.url);
+const fileType = require('./index.js');
+
+// Re-export everything as named exports
+export const fromFile = fileType.fromFile;
+export const fileTypeFromFile = fileType.fileTypeFromFile || fileType.fromFile;
+export const fromBuffer = fileType.fromBuffer;
+// Explicitly export fileTypeFromBuffer - webpack needs this for static analysis
+export const fileTypeFromBuffer = fileType.fileTypeFromBuffer || fileType.fromBuffer;
+export const fromStream = fileType.fromStream;
+export const fromTokenizer = fileType.fromTokenizer;
+export const extensions = fileType.extensions;
+export const mimeTypes = fileType.mimeTypes;
+export const stream = fileType.stream;
+
+// Also export as default
+export default fileType;
+
