{
  "name": "crilli",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^2.2.2",
    "@payloadcms/db-vercel-postgres": "3.84.0",
    "@payloadcms/next": "3.84.0",
    "@payloadcms/plugin-ecommerce": "3.84.0",
    "@payloadcms/plugin-seo": "3.84.0",
    "@payloadcms/richtext-lexical": "3.84.0",
    "@payloadcms/storage-vercel-blob": "3.84.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^1.0.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "graphql": "^16.8.1",
    "gsap": "^3.13.0",
    "next": "16.2.4",
    "payload": "3.84.0",
    "pg": "8.10.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sharp": "0.32.6",
    "stripe": "^19.3.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^24.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.4",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.3",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.80.6",
    "tailwindcss": "^4.1.4",
    "typescript": "5.7.3",
    "webpack": "^5.99.8"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "nodeLinker": "hoisted",
    "packageManagerStrict": true,
    "autoInstallPeers": true,
    "publicHoistPattern": [
      "*@payloadcms*",
      "*payload*",
      "*@swc*",
      "*next*"
    ],
    "onlyBuiltDependencies": [
      "@vercel/speed-insights",
      "sharp"
    ],
    "overrides": {
      "file-type": "^16.5.4",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "file-type": "patches/file-type.patch"
    }
  }
}
